# Copy this file to ".env" and fill in your own keys. ".env" is ignored by git: never commit real keys.

# --- Which language model writes and interprets the text -----------------------------------------
# "mistral" (default used in development) or "groq"
MODEL_PROVIDER=mistral

# Mistral (when MODEL_PROVIDER=mistral)
MISTRAL_API_KEY=your_mistral_key
# Stronger model used for the planner and every evidence/relevance decision.
MISTRAL_MODEL=open-mistral-nemo
# Optional split: preserve answer speed/cost without weakening clinical planning.
# MISTRAL_REASONING_MODEL=mistral-medium-latest
# MISTRAL_WRITER_MODEL=mistral-small-latest

# Groq (when MODEL_PROVIDER=groq)
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=openai/gpt-oss-120b

# A model call that has not answered after this many seconds fails instead of hanging the answer (default 30)
# MODEL_TIMEOUT_S=30

# --- Web search -----------------------------------------------------------------------------------
# Tavily is the main web search (regulator pages, guideline pages, medication pages). Without a key, or when the
# plan limit is reached, the free DDGS search is used instead; it is slower and less reliable.
TAVILY_API_KEY=your_tavily_key

# --- PubMed ---------------------------------------------------------------------------------------
# Optional but recommended: a free NCBI key raises the PubMed limit from about 3 to 10 requests a second.
# Get it at https://www.ncbi.nlm.nih.gov/ -> your account -> Account settings -> API Key Management.
NCBI_API_KEY=your_ncbi_key

# --- Server ---------------------------------------------------------------------------------------
# By default the server opens http://localhost:8000 in your browser. Set to 1 to disable that.
# NEUROGPT_NO_BROWSER=1

# Figures from the cited papers: off = chosen from the paper, licence and caption only (shown as 'not machine-checked'); on = a vision model must also confirm the image
FIGURE_IMAGE_CHECK=off
# Hybrid search: every retrieved paper is ranked by meaning (embeddings, Mistral) + words (BM25) + the sources' own order. Set off to disable.
HYBRID_SEARCH=on
# Second stage: a small local cross-encoder re-reads the question with each of the first papers. CROSS_ENCODER=off disables it; CROSS_ENCODER_MODEL overrides the model.
CROSS_ENCODER=on
# Which vision model checks the images when FIGURE_IMAGE_CHECK=on: groq (needs GROQ_API_KEY) or mistral. VISION_MODEL overrides the default model of the provider.
# VISION_PROVIDER=groq
# VISION_MODEL=qwen/qwen3.8-27b

# LangSmith tracing (optional, off by default). Everything a traced step receives or returns (question, abstracts, model prompts) is sent to LangSmith when on.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=neurogpt
# Intent-based query expansion: the quick plan call chooses the retrieval skills, each loads its SKILL.md and writes expanded searches. QUERY_EXPANSION=off disables it.
QUERY_EXPANSION=on

# Deep search routing (the fast search is never affected by any of these).
# The deep stage runs two searches together and merges them into one set: the legacy jobs (a fixed baseline, chosen by the question's intent) and the routed searches (written by the model for each
# information need). Switch either one off to compare them. The older names DEEP_ROUTING / LEGACY_DEEP still work when these are not set.
ENABLE_LEGACY_SEARCH=true
ENABLE_DEEP_ROUTING=true
# The most routed searches one question may run, and the most the coverage check may add.
ROUTING_MAX_QUERIES=14
ROUTING_MAX_COVERAGE_ADDITIONS=4
# Requests per second to each source, shared by both modes (PubMed: 2.5 without NCBI_API_KEY, 8 with one, under NCBI's 3 and 10). Change one with RATE_<SOURCE>_PER_S, for example RATE_FDA_PER_S=4.
# Hard deadlines in seconds: ROUTING_DEADLINE_S = how long the evidence group waits for the routed searches; ROUTING_BUDGET_S = the time the routed searches get once their queries are written;
# ESCALATION_DEADLINE_S = the whole phase before the evidence is written (relevance reading + one alternate-source search per essential need that found nothing relevant).
ROUTING_DEADLINE_S=30
ROUTING_BUDGET_S=18
ESCALATION_DEADLINE_S=25
# Cross-encoder screen for web results (calibrated on saved runs; borderline results are left to the model-based assessment).
SCREEN_THRESHOLD=-8.0
SCREEN_MARGIN=2.0


# Free full text of the best open-access papers (methods, results, conclusion) for the writer
FULL_TEXT=on
FULL_TEXT_PAPERS=6
FULL_TEXT_WAIT_S=6

# Passage (chunk) ranking: the writer sees each paper's best passages, scored by the local cross-encoder
CHUNKING=on
CHUNKS_PER_PAPER=3


# The plan call (intent, information needed, medicines needed, skills) can use another provider than the other calls. Needs GROQ_API_KEY. Leave unset to use MODEL_PROVIDER.
# PLANNER_PROVIDER=groq
# PLANNER_MODEL=qwen/qwen3.8-27b
