# Copy this file to ".env" and fill in your own keys. ".env" is ignored by git: never commit real keys.

# --- Which language model writes and interprets the text -----------------------------------------
# "mistral" (default used in development) or "groq"
MODEL_PROVIDER=mistral

# Mistral (when MODEL_PROVIDER=mistral)
MISTRAL_API_KEY=your_mistral_key
# Stronger model used for the planner and every evidence/relevance decision.
MISTRAL_MODEL=open-mistral-nemo
# Optional split: preserve answer speed/cost without weakening clinical planning.
# MISTRAL_REASONING_MODEL=mistral-medium-latest
# MISTRAL_WRITER_MODEL=mistral-small-latest

# Groq (when MODEL_PROVIDER=groq)
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=openai/gpt-oss-120b

# A model call that has not answered after this many seconds fails instead of hanging the answer (default 30)
# MODEL_TIMEOUT_S=30

# --- Web search -----------------------------------------------------------------------------------
# Tavily is the main web search (regulator pages, guideline pages, medication pages). Without a key, or when the
# plan limit is reached, the free DDGS search is used instead; it is slower and less reliable.
TAVILY_API_KEY=your_tavily_key

# --- PubMed ---------------------------------------------------------------------------------------
# Optional but recommended: a free NCBI key raises the PubMed limit from about 3 to 10 requests a second.
# Get it at https://www.ncbi.nlm.nih.gov/ -> your account -> Account settings -> API Key Management.
NCBI_API_KEY=your_ncbi_key

# --- Server ---------------------------------------------------------------------------------------
# By default the server opens http://localhost:8000 in your browser. Set to 1 to disable that.
# NEUROGPT_NO_BROWSER=1

# Figures from the cited papers: off = chosen from the paper, licence and caption only (shown as 'not machine-checked'); on = a vision model must also confirm the image
FIGURE_IMAGE_CHECK=off
# Hybrid search: every retrieved paper is ranked by meaning (embeddings, Mistral) + words (BM25) + the sources' own order. Set off to disable.
HYBRID_SEARCH=on
# Second stage: a small local cross-encoder re-reads the question with each of the first papers. CROSS_ENCODER=off disables it; CROSS_ENCODER_MODEL overrides the model.
CROSS_ENCODER=on
# Which vision model checks the images when FIGURE_IMAGE_CHECK=on: groq (needs GROQ_API_KEY) or mistral. VISION_MODEL overrides the default model of the provider.
# VISION_PROVIDER=groq
# VISION_MODEL=qwen/qwen3.8-27b

# LangSmith tracing (optional, off by default). Everything a traced step receives or returns (question, abstracts, model prompts) is sent to LangSmith when on.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=neurogpt
# Intent-based query expansion: the quick plan call chooses the retrieval skills, each loads its SKILL.md and writes expanded searches. QUERY_EXPANSION=off disables it.
QUERY_EXPANSION=on

# Deep search routing (the fast search is never affected by any of these).
# The deep stage runs two searches together and merges them into one set: the legacy jobs (a fixed baseline, chosen by the question's intent) and the routed searches (written by the model for each
# information need). Switch either one off to compare them. The older names DEEP_ROUTING / LEGACY_DEEP still work when these are not set.
ENABLE_LEGACY_SEARCH=true
ENABLE_DEEP_ROUTING=true
# Other names for the same thing: the condition words are looked up in the MeSH vocabulary (NCBI) and its heading and entry terms are added to the deep PubMed / Europe PMC searches (legacy and routed),
# and PubMed's "similar articles" of the best papers are added. Set false to switch either off. The fast first search never uses them.
ENABLE_MESH_EXPANSION=true
ENABLE_SIMILAR_ARTICLES=true
# The most routed searches one question may run, and the most the coverage check may add.
ROUTING_MAX_QUERIES=14
ROUTING_MAX_COVERAGE_ADDITIONS=4
# Requests per second to each source, shared by both modes (PubMed: 2.5 without NCBI_API_KEY, 8 with one, under NCBI's 3 and 10). Change one with RATE_<SOURCE>_PER_S, for example RATE_FDA_PER_S=4.
# Hard deadlines in seconds: ROUTING_DEADLINE_S = how long the evidence group waits for the routed searches; ROUTING_BUDGET_S = the time the routed searches get once their queries are written;
# ESCALATION_DEADLINE_S = the whole phase before the evidence is written (relevance reading + one alternate-source search per essential need that found nothing relevant).
ROUTING_DEADLINE_S=30
ROUTING_BUDGET_S=18
ESCALATION_DEADLINE_S=25
# Cross-encoder screen for web results (calibrated on saved runs; borderline results are left to the model-based assessment).
SCREEN_THRESHOLD=-8.0
SCREEN_MARGIN=2.0


# Free full text of the best open-access papers (methods, results, conclusion) for the writer
FULL_TEXT=on
FULL_TEXT_PAPERS=6
FULL_TEXT_WAIT_S=6

# Passage (chunk) ranking: the writer sees each paper's best passages, scored by the local cross-encoder
CHUNKING=on
CHUNKS_PER_PAPER=3


# The plan call (intent, information needed, medicines needed, skills) can use another provider than the other calls. Needs GROQ_API_KEY. Leave unset to use MODEL_PROVIDER.
# PLANNER_PROVIDER=groq
# PLANNER_MODEL=qwen/qwen3.8-27b

# Extra web search keys: Exa and Brave are used only when listed in WEB_PROVIDERS (see above).
EXA_API_KEY=
BRAVE_API_KEY=

# --- Pipeline and sources --------------------------------------------------------------------------
# Not read any more: every question runs on the agent (async_agent_run.py) on the asyncio pipeline; the older threaded pipeline answers only if the agent run cannot even start.
ASYNC_PIPELINE=1
# on = PubMed, Europe PMC, ClinicalTrials.gov and DailyMed are searched through Tavily only (experiment: no trial phase or status, no parsed label dosing; needs ASYNC_PIPELINE=1). off = their own APIs (recommended).
SOURCES_VIA_TAVILY=off

# --- Web search settings ---------------------------------------------------------------------------
# Providers that run together on every web search: tavily, exa, brave (comma separated). A provider only runs when it is listed here AND has a key, so list exa to have it take over when Tavily's quota is finished.
WEB_PROVIDERS=tavily,exa
# Tavily search depth: advanced = deeper reading and better matching (2 credits per search); basic = cheaper (1 credit).
TAVILY_DEPTH=advanced
# on = Tavily is sent the question as a sentence beside the search words ("<question> Focus: <query>"), so it can match on meaning. off = the search words only.
TAVILY_NATURAL=on
# Exa retrieval mode: neural = semantic (embedding) search; keyword = keyword; auto = Exa decides.
EXA_SEARCH_TYPE=neural
# on = ask Tavily for WEB_OVERFETCH times more pages, then keep the ones whose text is closest in meaning to the question (embeddings). off = Tavily's own order.
WEB_SEMANTIC=on
WEB_OVERFETCH=3
# Seconds allowed for that selection's embedding call; when it is slower, Tavily's own order is kept.
WEB_EMBED_TIMEOUT_S=3

# --- Embeddings (hybrid search and the web selection above) ----------------------------------------
# Default: Mistral (MISTRAL_API_KEY). EMBED_PROVIDER=openai uses OpenAI embeddings (OPENAI_API_KEY). EMBED_MODEL overrides the model.
# EMBED_PROVIDER=openai
# EMBED_MODEL=
# OPENAI_API_KEY=
# Seconds allowed for the embedding call of the hybrid search; when it is slower, the lexical + source order is used.
EMBED_TIMEOUT_S=6

# --- Tavily mode for PubMed, Europe PMC, ClinicalTrials.gov and DailyMed (only used when SOURCES_VIA_TAVILY=on and ASYNC_PIPELINE=1) ---
# The FAST pass (first answer, a few seconds, Boolean PubMed query) uses the sources' own APIs even in this mode; on = it uses Tavily too (slower, and the first answer is often built from partial results).
FAST_VIA_TAVILY=off
# Soft run deadline in seconds on the run clock (0 = off). The drug stage's OPTIONAL work (extra web sources, second reading, class expansion, dose lookups, label wait) is cut when it is passed; the first reading of the sources is never cut.
RUN_DEADLINE_S=0
# A NEW question's plan call gets a shorter prompt (the follow-up part of the skill, the follow-up part of the guide and the follow-up fields of the research tool are left out; the plan fields and their text are unchanged). off = the full prompt.
ORCHESTRATOR_TRIM=off
# --- The drug agent (async_drug_agent.py): a separate agent for the drug side. It starts when the plan is ready, writes its own expanded drug searches (drug-intelligence skill as its prompt), searches, ranks its own papers
# (hybrid semantic ranking + the local cross-encoder) and hands them to the drug stage, which then reads them while the main pipeline is still searching. The main pipeline's sources are read afterwards as a top-up.
# off = the drug stage starts after the main pipeline's ranking, as before. When the agent fails, the same fallback is used automatically.
DRUG_AGENT=off
DRUG_AGENT_BUDGET_S=28
DRUG_AGENT_QUERY_S=10
DRUG_AGENT_SEARCH_S=12
DRUG_AGENT_CROSS=on
DRUG_AGENT_CROSS_TOP=44
DRUG_AGENT_WAIT_S=30
DRUG_FRESH_MAX=40
# Tavily does the SEARCHING (a meaning-based search of the source's own web pages); the source's own API then READS each record Tavily found, by identifier (PMID, NCT number, DailyMed set id).
# Any of these set to off goes back to the plainer behaviour.
# The question as a sentence, more pages than needed, the pages closest in meaning kept (the same selection the web searches use).
TAVILY_SOURCES_SEMANTIC=on
# Read each record by identifier: authors, journal, study type, PMC id (figures, full text), trial phase and status, label dosing. Off = only what a web page excerpt shows.
TAVILY_SOURCES_ENRICH=on
# When Tavily gives nothing usable (no key, quota finished, an error), the source's own API answers instead.
TAVILY_SOURCES_FALLBACK=on
# Seconds the identifier lookups get; a lookup that is late leaves the Tavily-only record.
TAVILY_ENRICH_TIMEOUT_S=6

FDA_CACHE_TTL_S=21600
OPENING_SPECULATIVE=on

# --- The agent (async_agent_run.py): every question runs on an Agno agent that chooses which stage runs next (the stages are its tools). There is no off switch.
# The fast path (fast_search, fast_answer) runs first in code. Ranking (hybrid + cross-encoder), verification and finalize are enforced in code whatever the agent does; if the agent stops early,
# fails or runs out of time, the missing stages run in the default order. The values below only limit it.
AGENT_MAX_STEPS=20
AGENT_BUDGET_S=300
AGENT_MAX_SEARCHES=3

# deep_search and rank run beside the fast answer (their events are shown after it). off: they wait for it, as before.
OVERLAP_FAST_ANSWER=on

# A short message (12 words or fewer) is read by one tiny model call: CLINICAL (research it) or a short friendly reply the model writes itself ('hi', 'how are you', 'thanks'), with no report.
CLINICAL_GATE=on
CLINICAL_GATE_WAIT_S=4

SOURCES_MODE=both
BOTH_TAVILY_GRACE_S=1.0

# EMBED_PROVIDER=local: embeddings made on this computer (fastembed); the model below is downloaded once (about 130 MB)
# EMBED_PROVIDER=local
# EMBED_LOCAL_MODEL=BAAI/bge-small-en-v1.5
# EMBED_LOCAL_TIMEOUT_S=20
