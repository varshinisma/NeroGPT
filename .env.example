# Copy this file to ".env" and fill in your own keys. ".env" is ignored by git: never commit real keys.

# --- Which language model writes and interprets the text -----------------------------------------
# "mistral" (default used in development) or "groq"
MODEL_PROVIDER=mistral

# Mistral (when MODEL_PROVIDER=mistral)
MISTRAL_API_KEY=your_mistral_key
MISTRAL_MODEL=open-mistral-nemo

# Groq (when MODEL_PROVIDER=groq)
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=openai/gpt-oss-120b

# A model call that has not answered after this many seconds fails instead of hanging the answer (default 30)
# MODEL_TIMEOUT_S=30

# --- Web search -----------------------------------------------------------------------------------
# Tavily is the main web search (regulator pages, guideline pages, medication pages). Without a key, or when the
# plan limit is reached, the free DDGS search is used instead; it is slower and less reliable.
TAVILY_API_KEY=your_tavily_key

# --- PubMed ---------------------------------------------------------------------------------------
# Optional but recommended: a free NCBI key raises the PubMed limit from about 3 to 10 requests a second.
# Get it at https://www.ncbi.nlm.nih.gov/ -> your account -> Account settings -> API Key Management.
NCBI_API_KEY=your_ncbi_key

# --- Server ---------------------------------------------------------------------------------------
# By default the server opens http://localhost:8000 in your browser. Set to 1 to disable that.
# NEUROGPT_NO_BROWSER=1
