# NeroGPT settings. Copy this file to .env and fill in your own keys (.env is git-ignored, never commit it).

# ---- API keys
TAVILY_API_KEY=your-tavily-key
NCBI_API_KEY=your-ncbi-key # optional, raises the PubMed rate limit
EXA_API_KEY=your-exa-key # optional, not used when WEB_PROVIDERS=tavily
OPENAI_API_KEY=your-openai-key

# ---- Models (OpenAI for every model call)
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=none
MODEL_TIMEOUT_S=60
MODEL_JSON_CONCURRENCY=8
RATE_LIMIT_RETRIES=5
RATE_LIMIT_MAX_WAIT_S=20
TPM_LIMIT=100000

# ---- Where the evidence comes from
SOURCES_MODE=tavily   # direct | tavily | both for PubMed, Europe PMC, ClinicalTrials.gov (FDA labels stay direct)
SOURCES_VIA_TAVILY=on
FAST_VIA_TAVILY=off
BOTH_TAVILY_GRACE_S=1.0   # both mode: Tavily may answer this many seconds after the direct APIs
WEB_PROVIDERS=tavily   # web search providers (exa dropped: 429 on every call)
TAVILY_DEPTH=advanced   # advanced = deeper, more credits; basic = cheaper
EXA_SEARCH_TYPE=neural
WEB_SEMANTIC=on
WEB_OVERFETCH=3   # ask Tavily for this many times more pages, keep the closest by meaning

# ---- Search planning and drugs
ENABLE_DEEP_ROUTING=true
ENABLE_LEGACY_SEARCH=false   # false skips the legacy templates except the drug ones (see ENABLE_DRUG_SEARCH)
ROUTING_MAX_QUERIES=22
ENABLE_DRUG_SEARCH=on   # on keeps the legacy drug template searches; off removes them
DRUG_AGENT=off
DRUG_PAPERS=44
DRUG_WEB_PAGES=36
DRUG_CLASS_EXPAND=6
DRUG_CLASS_EXPAND_S=14
DRUG_RETRY_BELOW=4
MAX_USED_DRUGS=36
SHOW_SYMPTOM_DRUGS=on

# ---- Ranking and reading
EMBED_PROVIDER=local   # local = fastembed bge-small-en-v1.5 on this computer (downloaded once, about 130 MB)
CROSS_TOP_NEW=8   # papers sent to the local cross-encoder for a new question
TRIAGE_PAPERS=24

# ---- Time limits (seconds)
RUN_DEADLINE_S=50
ROUTING_DEADLINE_S=40
DEEP_BUDGET_S=50
ESCALATION_DEADLINE_S=10
LANDSCAPE_WAIT_S=25
EVIDENCE_GRACE_S=18
LABEL_WAIT_S=10
FAST_TIMEOUT_S=3.0
FAST_FIRST_S=3.5
FAST_GRACE_S=4.5
FAST_LATE_FDA_S=4.0
FAST_EXTRA_S=1.0
NEW_ROUTING_DEADLINE_S=22
NEW_ROUTING_BUDGET_S=12
NEW_DEEP_BUDGET_S=38   # NEW_* = limits for a new question (shorter than the ordinary ones above)
NEW_DEEP_TIMEOUT_S=12
NEW_EVIDENCE_GRACE_S=8
NEW_ESCALATION_DEADLINE_S=7
NEW_LANDSCAPE_WAIT_S=30

# ---- Pipeline switches and caches
ASYNC_PIPELINE=1
ORCHESTRATOR_TRIM=on
OPENING_SPECULATIVE=on   # start the opening rewrite while the drug stage runs
SECTION_ORDER=ready
FIGURE_IMAGE_CHECK=off   # vision check of figure images (needs a Groq or Mistral vision key)
FDA_CACHE_TTL_S=21600   # openFDA answers kept this many seconds; 0 = off

# ---- Tracing
LANGSMITH_TRACING=true   # quota is used up: tracing switches itself off, local traces go to demo_output/traces
LANGSMITH_API_KEY=your-langsmith-key # optional
LANGSMITH_PROJECT=neurogpt

# ---- Not in use (kept for later)
# MISTRAL_API_KEY=your-mistral-key
# GROQ_API_KEY=your-groq-key
# MISTRAL_MODEL=open-mistral-nemo
# GROQ_MODEL=openai/gpt-oss-120b
